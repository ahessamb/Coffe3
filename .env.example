# Copy these into cPanel → Setup Python App → your app → Environment variables.
# Do NOT commit real secrets to GitHub.

DJANGO_SECRET_KEY=replace-with-long-random-string
DJANGO_DEBUG=0

# Optional extra hosts (comma-separated). Defaults already include zhinad.ir domains.
# DJANGO_ALLOWED_HOSTS=zhinad.ir,www.zhinad.ir,zhinadcoffee.ir,www.zhinadcoffee.ir

WAGTAILADMIN_BASE_URL=https://zhinadcoffee.ir

# MySQL (create database in cPanel → MySQL Databases first)
DB_ENGINE=django.db.backends.mysql
DB_NAME=cpaneluser_zhinad
DB_USER=cpaneluser_zhinad
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Leave DB_NAME unset to use SQLite (ok for testing only on shared hosting)

DJANGO_SERVE_MEDIA=1
DJANGO_SECURE_PROXY=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
